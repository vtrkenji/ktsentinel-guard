[Unit]
Description=kTsentinel Guard (detecção de movimento RTSP + FCM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;15000000"
ExecStart=%h/.local/share/ktsentinel-guard/venv/bin/sentinel-guard run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
